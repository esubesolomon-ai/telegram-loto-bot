# Telegram bot token from BotFather (keep secret)
BOT_TOKEN=replace_me
# Random secret, 1-256 chars, letters/numbers/_/- recommended
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
# Comma-separated numeric Telegram user IDs for admins
ADMIN_IDS=123456789
# Keep false until the official provider integration is implemented and approved
TELEBIRR_ENABLED=false
# Keep false until legal approval, audited draw logic, and operational controls are ready
LIVE_DRAWS_ENABLED=false
# On Render, point this to the mounted persistent disk, e.g. /var/data/lottery.sqlite3
DB_PATH=./data/lottery.sqlite3
APP_ENV=production
LOG_LEVEL=INFO
# Set this to your deployed HTTPS origin if you want it for documentation; webhook is configured separately
PUBLIC_BASE_URL=https://your-service.onrender.com
